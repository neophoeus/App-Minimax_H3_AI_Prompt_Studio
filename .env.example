# GEMINI_API_KEY: Required for Gemini API Direct calls (Free Tier / Pay-as-you-go).
# Configure your Gemini API key from Google AI Studio or Google Cloud.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Ollama Local AI Configuration (Optional / Tri-Engine Mode)
# Default base URL for local Ollama service
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Default local Ollama model to use when Ollama provider is selected
DEFAULT_OLLAMA_MODEL="orcarouter/Qwen3.8-27B-Uncensored:q6_K"

# llama.cpp Local AI Configuration (Optional / Tri-Engine Mode)
# Default base URL for local llama.cpp server (llama-server)
LLAMACPP_BASE_URL="http://127.0.0.1:8080"

# Default model name or alias for llama.cpp server
DEFAULT_LLAMACPP_MODEL="default"

# Default AI provider on startup: 'gemini', 'ollama', or 'llamacpp'
DEFAULT_AI_PROVIDER="gemini"

# Local inference timeouts (in milliseconds, default 600000 = 10 minutes)
LLAMACPP_TIMEOUT_MS=600000
OLLAMA_TIMEOUT_MS=600000
