{
  "name": "react-example",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server-paid-api.ts",
    "dev:aistudio": "tsx server-aistudio.ts",
    "dev:paid-api": "tsx server-paid-api.ts",
    "dev:ollama": "tsx server-ollama.ts",
    "dev:llamacpp": "tsx server-llamacpp.ts",
    "pack:aistudio": "tsx scripts/pack-aistudio.ts",
    "build": "vite build && esbuild server-paid-api.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:aistudio": "vite build && esbuild server-aistudio.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
